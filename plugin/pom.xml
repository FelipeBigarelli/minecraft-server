<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>codes.biga</groupId>
    <artifactId>bigacore</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BigaCore</name>
    <description>Plugin base para Paper 26.2</description>

    <properties>
        <!-- O Minecraft 26.2 roda em Java 25. A API é publicada em
             bytecode 25, então o compilador precisa de release 25
             ou o build falha ao ler as classes. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ⚠️ VERSÃO FIXA, NUNCA UM RANGE ABERTO.

             Esta build (167) é a MESMA do jar em ~/minecraft/paper-26.3-167.jar.
             Compilar contra uma API diferente da que roda no servidor é
             como programar contra uma versão de biblioteca e instalar
             outra: compila e explode em runtime.

             Um range tipo [26.2.build,) parece prático e tem três defeitos:
               1. build não reprodutível — resolve diferente a cada dia
               2. pega pré-release (26.2.build.93-beta > 26.2.build.92-stable)
               3. pula de versão do MC — quando sair a 26.3, o range subiria
                  sozinho para a API dela, contra um servidor ainda em 26.2

             Ao atualizar o Paper: troque este número E o PAPER_BUILD do
             start.sh no mesmo commit. Os dois andam juntos. -->
        <paper.version>26.3.build.167-beta</paper.version>

        <!-- Mesma regra do paper.version: numero fixo, igual ao jar que esta
             em ~/minecraft/plugins/. Compilar contra a 7.0.21 e rodar na
             7.0.19 passa no build e estoura em jogo, no primeiro metodo que
             so existe na versao nova.

             Atencao ao atualizar: o jar do servidor e um jar PATCHEADO com a
             traducao pt-BR (server/scripts/traducao-worldguard/). Subir a
             versao aqui sem repassar o patcher deixa o plugin em ingles. -->
        <worldguard.version>7.0.19</worldguard.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <!-- WorldGuard e WorldEdit nao estao no Maven Central. -->
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- paper-api é um superset da spigot-api: todo org.bukkit.*
             continua aqui, mais Adventure (texto rico), Brigadier
             (comandos) e as APIs próprias do Paper.

             scope=provided: o servidor já traz essas classes em runtime.
             Embutir no jar causaria conflito de classloader — duas cópias
             da mesma classe, e o Java trata como tipos diferentes. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- A venda de terreno no survival nao tem motor de protecao proprio:
             ela cria regiao de WorldGuard. O servidor ja tem o WorldGuard
             instalado, configurado e com as mensagens traduzidas, e o jogador
             ja conhece as flags dele. Escrever um segundo sistema de protecao
             ao lado seria duas verdades sobre quem pode construir onde.

             Aqui a dependencia e de compilacao de verdade, nao reflexao como
             no VaultEconomyBridge e no PlotApiBridge. A diferenca e que o
             WorldGuard publica API versionada: refletir sobre RegionContainer,
             RegionManager, ProtectedCuboidRegion, DefaultDomain e BlockVector3
             daria um arquivo ilegivel que erra em runtime em vez de no build.

             scope=provided pelo mesmo motivo da paper-api, e aqui com um
             agravante: duas copias das classes do WorldGuard em classloaders
             diferentes fariam a regiao criada por nos ser de um tipo que o
             WorldGuard do servidor nao reconhece. -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>${worldguard.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- O worldguard-bukkit arrasta o worldedit-bukkit, que
                     depende da spigot-api. Sem esta exclusao ficam duas
                     copias de org.bukkit no classpath de compilacao e quem
                     ganha depende da ordem de resolucao do Maven. Fica so a
                     paper-api, que e superset da spigot-api. -->
                <exclusion>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Só para teste. O escopo provided da paper-api também vale no
             classpath de teste, então o teste consegue usar exatamente o
             PluginDescriptionFile (e o snakeyaml) que o Paper usa no boot. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Faz o Maven substituir ${project.version} dentro do
             plugin.yml, para não versionar em dois lugares. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- O surefire herdado do super-POM é o 2.12.4, que não enxerga
                 JUnit 5 e simplesmente reporta "No tests to run". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
