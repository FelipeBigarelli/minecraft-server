<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>codes.biga</groupId>
    <artifactId>bigacore</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BigaCore</name>
    <description>Plugin base para Paper 26.2</description>

    <properties>
        <!-- O Minecraft 26.2 roda em Java 25. A API é publicada em
             bytecode 25, então o compilador precisa de release 25
             ou o build falha ao ler as classes. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ⚠️ VERSÃO FIXA, NUNCA UM RANGE ABERTO.

             Esta build (92) é a MESMA do jar em ~/minecraft/paper-26.2-92.jar.
             Compilar contra uma API diferente da que roda no servidor é
             como programar contra uma versão de biblioteca e instalar
             outra: compila e explode em runtime.

             Um range tipo [26.2.build,) parece prático e tem três defeitos:
               1. build não reprodutível — resolve diferente a cada dia
               2. pega pré-release (26.2.build.93-beta > 26.2.build.92-stable)
               3. pula de versão do MC — quando sair a 26.3, o range subiria
                  sozinho para a API dela, contra um servidor ainda em 26.2

             Ao atualizar o Paper: troque este número E o PAPER_BUILD do
             start.sh no mesmo commit. Os dois andam juntos. -->
        <paper.version>26.2.build.92-stable</paper.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- paper-api é um superset da spigot-api: todo org.bukkit.*
             continua aqui, mais Adventure (texto rico), Brigadier
             (comandos) e as APIs próprias do Paper.

             scope=provided: o servidor já traz essas classes em runtime.
             Embutir no jar causaria conflito de classloader — duas cópias
             da mesma classe, e o Java trata como tipos diferentes. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Só para teste. O escopo provided da paper-api também vale no
             classpath de teste, então o teste consegue usar exatamente o
             PluginDescriptionFile (e o snakeyaml) que o Paper usa no boot. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Faz o Maven substituir ${project.version} dentro do
             plugin.yml, para não versionar em dois lugares. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- O surefire herdado do super-POM é o 2.12.4, que não enxerga
                 JUnit 5 e simplesmente reporta "No tests to run". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
